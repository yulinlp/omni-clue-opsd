#!/usr/bin/env bash
# WorldSense answer-conditioned CLUE-OPSD, worker-1/2, 16 x Ascend 910B1.
set -euo pipefail

node_rank="${1:?usage: $0 NODE_RANK(0|1)}"
[[ "${node_rank}" == 0 || "${node_rank}" == 1 ]] || exit 2

repo="/opt/huawei/dataset/hyl_ulan/ylhu/omni-clue-opsd"
run_root="${repo}/training_runs/worldsense_clue_opsd_gold_r64_w1w2"
model="/opt/huawei/dataset/hyl_ulan/ylhu/omni-opsd-assets/models/Qwen2.5-Omni-7B"
deps="/opt/huawei/dataset/hyl_ulan/ylhu/omni-opsd-runtime/worldsense_npu24_deps"
swift_root="/opt/huawei/dataset/hyl_ulan/ylhu/third_party/ms-swift"
python_bin="/home/ma-user/anaconda3/envs/PyTorch-2.9.0/bin/python"
dataset="${OMNI_OPSD_DATASET:-${run_root}/data/clue_opsd_gold.jsonl}"
output="${OMNI_OPSD_OUTPUT_DIR:-${run_root}/outputs/formal}"

export PYTHONPATH="${deps}:${swift_root}${PYTHONPATH:+:${PYTHONPATH}}"
export NPROC_PER_NODE="${OMNI_OPSD_NPROC_PER_NODE:-8}"
export NNODES="${OMNI_OPSD_NNODES:-2}"
export NODE_RANK="${node_rank}"
export MASTER_ADDR="${OMNI_OPSD_MASTER_ADDR:-172.16.12.237}"
export MASTER_PORT="${OMNI_OPSD_MASTER_PORT:-29531}"
export ASCEND_RT_VISIBLE_DEVICES="${ASCEND_RT_VISIBLE_DEVICES:-0,1,2,3,4,5,6,7}"
if [[ "${NNODES}" == 1 && "${NPROC_PER_NODE}" == 1 ]]; then
  unset RANK_TABLE_FILE RANK_TABLE_FILE_V_1_0 || true
else
  export RANK_TABLE_FILE="${run_root}/data/ranktable_w1w2.json"
  export RANK_TABLE_FILE_V_1_0="${RANK_TABLE_FILE}"
fi
export USE_AUDIO_IN_VIDEO=1
export FORCE_QWENVL_VIDEO_READER=pyav_seek
export MAX_NUM_WORKERS_FETCH_VIDEO=1
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export TOKENIZERS_PARALLELISM=false
export PYTORCH_NPU_ALLOC_CONF=expandable_segments:True
export WORLDSENSE_LOGITS_TO_KEEP=1
export WORLDSENSE_DROP_TALKER=1
export WORLDSENSE_GOLD_CE_ALPHA="${WORLDSENSE_GOLD_CE_ALPHA:-0.25}"
export WORLDSENSE_GOLD_DATASET="${dataset}"
export HCCL_CONNECT_TIMEOUT=600
export PYTHONUNBUFFERED=1

for path in "${dataset}" "${model}/config.json" "${deps}/qwen_omni_utils" ${RANK_TABLE_FILE:+"${RANK_TABLE_FILE}"}; do
  [[ -e "${path}" ]] || { echo "missing: ${path}" >&2; exit 2; }
done
mkdir -p "${output}"

args=(
  --rlhf_type gkd
  --model "${model}"
  --dataset "${dataset}"
  --output_dir "${output}"
  --split_dataset_ratio 0
  --tuner_type lora
  --lora_rank 64
  --lora_alpha 128
  --target_modules all-linear
  --lmbda 1.0
  --beta 0.5
  --temperature 1.0
  --clue_ema_alpha 0.05
  --sft_alpha 0
  --gkd_logits_topk 100
  --torch_dtype bfloat16
  --num_train_epochs 3
  --per_device_train_batch_size 1
  --gradient_accumulation_steps "${OMNI_OPSD_GRADIENT_ACCUMULATION_STEPS:-2}"
  --learning_rate 2e-6
  --lr_scheduler_type cosine
  --warmup_ratio 0.03
  --save_strategy epoch
  --save_total_limit 3
  --logging_steps 1
  --max_length 32768
  --max_completion_length 1
  --use_logits_to_keep true
  --gradient_checkpointing true
  --attn_impl sdpa
  --use_vllm false
  --dataset_num_proc 1
  --dataloader_num_workers 0
  --no_dataset_shuffle
  --seed 20260904
  --report_to none
)
if [[ -n "${OMNI_OPSD_MAX_STEPS:-}" ]]; then args+=(--max_steps "${OMNI_OPSD_MAX_STEPS}"); fi
if [[ -n "${OMNI_OPSD_SAVE_STEPS:-}" ]]; then args+=(--save_strategy steps --save_steps "${OMNI_OPSD_SAVE_STEPS}"); fi
exec "${python_bin}" -m torch.distributed.run \
  --nproc_per_node "${NPROC_PER_NODE}" \
  --nnodes "${NNODES}" \
  --node_rank "${NODE_RANK}" \
  --master_addr "${MASTER_ADDR}" \
  --master_port "${MASTER_PORT}" \
  "${repo}/training_code/scripts/clue_answer_gkd_entry.py" "${args[@]}"
